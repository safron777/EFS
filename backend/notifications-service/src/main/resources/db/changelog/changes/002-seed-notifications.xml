<?xml version="1.0" encoding="UTF-8"?>
<!--
  Seed data from src/api/mockData.js `notifications` + `notificationMethod`
  exports, the one demo-wide fixture (story Boundaries & Constraints: no
  per-card seed variation). No wire-format correction is needed here (unlike
  story 8's cashback/AD-3): notifications carry no monetary field.

  Channels are seeded in mock order (sms-ops, sms-plan, push) via sort_order
  1-3, all `enabled=true` to match the mock's current `on: true` for all
  three rows today.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="002-seed-notification-channels" author="notifications-service">
        <insert tableName="notification_channels">
            <column name="id" value="sms-ops"/>
            <column name="title" value="SMS по операциям"/>
            <column name="subtitle" value="Списания и зачисления по карте •••• 4019"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="action" value="Отключить"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>

        <insert tableName="notification_channels">
            <column name="id" value="sms-plan"/>
            <column name="title" value="SMS о плановых платежах"/>
            <column name="subtitle" value="Напоминания за 3 дня до списания"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="action" value="Отключить"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>

        <insert tableName="notification_channels">
            <column name="id" value="push"/>
            <column name="title" value="Push-уведомления в приложении"/>
            <column name="subtitle" value="Операции, кэшбэк, акции"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="action" value="Настроить"/>
            <column name="sort_order" valueNumeric="3"/>
        </insert>
    </changeSet>

    <changeSet id="002-seed-notification-method" author="notifications-service">
        <insert tableName="notification_method">
            <column name="id" value="notification-method"/>
            <column name="title" value="Способ уведомлений (ОМТ)"/>
            <column name="current" value="Email · v***@mail.ru"/>
        </insert>
    </changeSet>

</databaseChangeLog>
