<?xml version="1.0" encoding="UTF-8"?>
<!--
  Seed data from src/api/mockData.js `cashback` export, the one demo-wide
  fixture (story Boundaries & Constraints: no per-card seed variation),
  with the one deliberate wire-format correction the mock itself doesn't
  make (AD-3):

    - accumulated: the mock's raw-ruble 1240 becomes 124000 kopecks.

  `percent`/`tone` are seeded as the mock's exact literal strings,
  unchanged (story Boundaries & Constraints). Categories are seeded in
  mock order (cafe, azs, pharmacy, other) via sort_order 1-4.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="002-seed-cashback-summary" author="cashback-service">
        <insert tableName="cashback_summary">
            <column name="id" value="cashback-summary"/>
            <column name="accumulated_minor_units" valueNumeric="124000"/>
            <column name="promo_title" value="Скидка 30% на связь МТС при оплате картой"/>
            <column name="promo_text"
                    value="Действует до 31.12.2026 · автоматически при оплате связи картой Zero"/>
        </insert>
    </changeSet>

    <changeSet id="002-seed-cashback-categories" author="cashback-service">
        <insert tableName="cashback_categories">
            <column name="id" value="cafe"/>
            <column name="label" value="Кафе и рестораны"/>
            <column name="percent" value="5%"/>
            <column name="tone" value="green"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>

        <insert tableName="cashback_categories">
            <column name="id" value="azs"/>
            <column name="label" value="АЗС"/>
            <column name="percent" value="3%"/>
            <column name="tone" value="green"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>

        <insert tableName="cashback_categories">
            <column name="id" value="pharmacy"/>
            <column name="label" value="Аптеки"/>
            <column name="percent" value="7%"/>
            <column name="tone" value="green"/>
            <column name="sort_order" valueNumeric="3"/>
        </insert>

        <insert tableName="cashback_categories">
            <column name="id" value="other"/>
            <column name="label" value="Прочее"/>
            <column name="percent" value="1%"/>
            <column name="tone" value="gray"/>
            <column name="sort_order" valueNumeric="4"/>
        </insert>
    </changeSet>

</databaseChangeLog>
