<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.mtsbank.cardoffice</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>incident-case-service</artifactId>
  <packaging>jar</packaging>
  <name>incident-case-service</name>
  <description>
    CAP-10/CAP-11 (incident case): mass incidents (Kafka-consumed), single incidents, complaints. Story 10 adds CAP-10: three @KafkaListener consumers populating this service's own
    read model, GET /incidents/mass, POST /incidents/mass/{incidentId}/attach, Liquibase-backed (see docs/specs/spec-mts-client-card-office-backend/stories/10-incident-case-mass-incidents.md).
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <!-- Jakarta Bean Validation (@NotBlank on AttachClientRequest): not pulled in
           transitively by spring-boot-starter-web, same precedent as
           card-issuance-service's @NotBlank usage. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- AD-5, AD-11: the three @KafkaListener consumers plus the NewTopic beans
           (KafkaAdmin auto-configures itself once this and a bootstrap-servers
           property are present). Spring Boot 4 split Kafka autoconfiguration out
           of spring-boot-autoconfigure into its own spring-boot-kafka module (the
           same per-feature split liquibase-core/spring-boot-liquibase already
           follow below), pulled in transitively by this starter. Version managed
           by the Spring Boot 4.1.1 BOM (spring-kafka 4.1.1, kafka-clients 4.2.1),
           verified to interoperate with the broker's apache/kafka:4.3.1 image
           (same 4.x wire protocol generation; Kafka clients are both backward and
           forward compatible across minor releases within a major version). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- AD-12: schema migrations via Liquibase, version managed by the Spring
           Boot BOM (not overridden, stays on Boot's tested pairing, per
           ARCHITECTURE-SPINE.md Stack table). -->
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>
    <dependency>
      <!-- Spring Boot 4's autoconfigure module was split per-feature;
           LiquibaseAutoConfiguration (which actually wires spring.liquibase.*
           and runs the changelog on startup) now lives here rather than in
           spring-boot-autoconfigure. liquibase-core alone is not sufficient. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- WebTestClient against a Servlet-stack (spring-boot-starter-web) app
           needs the WebFlux client on the test classpath; it is not pulled
           in by spring-boot-starter-test alone. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- KafkaTestUtils (polling records off the dead-letter topic in the
           listener integration test) and other Spring Kafka test helpers. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Testcontainers 2.x renamed its modules with a testcontainers- prefix
           (e.g. junit-jupiter -> testcontainers-junit-jupiter); the Java package
           (org.testcontainers.junit.jupiter) is unchanged. -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- This service's integration tests run against a real Testcontainers
           Kafka broker (story Code Map/Tasks), not Spring Kafka's embedded
           broker, consistent with every other service's Testcontainers-only
           testing convention (spine Consistency Conventions). -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>incident-case-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
