<?xml version="1.0" encoding="UTF-8"?>
<!--
  CAP-11 seed: the mock's 2 singleIncidents + 2 complaints rows for
  client-1, literal ids verbatim from src/api/mockData.js (story Boundaries
  & Constraints: "The two seeded rows in each table reproduce
  mockData.singleIncidents/mockData.complaints verbatim, including their
  literal id strings"). This is a deliberate divergence from the ЕИ-<n>/
  complaint-<n> generation scheme new rows get via 002's sequences:
  complaints' seeded ids keep the mock's own display strings ("Жалоба
  №118240", "Претензия №117580"), not the complaint-<n> format (story
  Design Notes).

  created_date ISO-8601 conversion from the mock's dd.MM.yyyy strings:
    - single incidents: "02.09.2026" -> 2026-09-02; "14.08.2026" -> 2026-08-14.
    - complaints: "10.09.2026" -> 2026-09-10; "20.07.2026" -> 2026-07-20.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-seed-single-incidents" author="incident-case-service">
        <insert tableName="single_incidents">
            <column name="id" value="ЕИ-118225"/>
            <column name="client_id" value="client-1"/>
            <column name="theme" value="Некорректный баланс по карте"/>
            <column name="created_date" valueDate="2026-09-02"/>
            <column name="line" value="2 линия"/>
            <column name="status" value="В работе"/>
        </insert>

        <insert tableName="single_incidents">
            <column name="id" value="ЕИ-117904"/>
            <column name="client_id" value="client-1"/>
            <column name="theme" value="Ошибка активации карты"/>
            <column name="created_date" valueDate="2026-08-14"/>
            <column name="line" value="2 линия"/>
            <column name="status" value="Решён"/>
        </insert>
    </changeSet>

    <changeSet id="003-seed-complaints" author="incident-case-service">
        <insert tableName="complaints">
            <column name="id" value="Жалоба №118240"/>
            <column name="client_id" value="client-1"/>
            <column name="theme" value="Перевод не пришёл получателю"/>
            <column name="created_date" valueDate="2026-09-10"/>
            <column name="term" value="2 дня"/>
            <column name="status" value="На 2 линии"/>
        </insert>

        <insert tableName="complaints">
            <column name="id" value="Претензия №117580"/>
            <column name="client_id" value="client-1"/>
            <column name="theme" value="Возврат комиссии за обслуживание"/>
            <column name="created_date" valueDate="2026-07-20"/>
            <column name="term" value="—"/>
            <column name="status" value="Удовлетворена"/>
        </insert>
    </changeSet>

</databaseChangeLog>
